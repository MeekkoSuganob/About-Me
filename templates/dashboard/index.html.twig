{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

{% for message in app.flashes('success') %}
    <p>{{ message }}</p>
{% endfor %}

<h2>Low stock</h2>
{% if lowStock is empty %}
    <p>All items are above their minimum level.</p>
{% else %}
    <table>
        <thead>
            <tr><th>Item</th><th>Quantity</th><th>Minimum</th><th></th></tr>
        </thead>
        <tbody>
        {% for item in lowStock %}
            <tr>
                <td>{{ item.name }}</td>
                <td>{{ item.quantity }}</td>
                <td>{{ item.minQuantity }}</td>
                <td><a href="{{ path('app_item_stock', {id: item.id}) }}">Stock in</a></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}

{% if is_granted('ROLE_MANAGER') %}
    <h2>Staff</h2>
    <table>
        <thead>
            <tr><th>Full name</th><th>Username</th><th>Role</th></tr>
        </thead>
        <tbody>
        {% for u in staff %}
            <tr>
                <td>{{ u.fullName }}</td>
                <td>{{ u.username }}</td>
                <td>{{ 'ROLE_MANAGER' in u.roles ? 'Manager' : 'Staff' }}</td>
            </tr>
        {% else %}
            <tr><td colspan="3">No accounts yet.</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}

{% endblock %}
