{% extends 'base.html.twig' %}

{% block title %}Transaction history{% endblock %}

{% block body %}
    <h1>Transaction history</h1>
    <table>
        <thead>
            <tr><th>Date</th><th>Item</th><th>Type</th><th>Qty</th><th>By</th><th>Note</th></tr>
        </thead>
        <tbody>
        {% for t in transactions %}
            <tr>
                <td>{{ t.createdAt|date('Y-m-d H:i') }}</td>
                <td>{{ t.item.name }}</td>
                <td>{{ t.type.label }}</td>
                <td>{{ t.quantity }}</td>
                <td>{{ t.user.fullName }}</td>
                <td>{{ t.note }}</td>
            </tr>
        {% else %}
            <tr><td colspan="6">No transactions yet.</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}