{% extends 'base.html.twig' %}

{% block title %}Hello DashboardController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

{% for message in app.flashes('success') %}
    <p>{{ message }}</p>
{% endfor %}

<h2>Low stock</h2>
{% if lowStock is empty %}
    <p>All items are above their minimum level.</p>
{% else %}
    <table>
        <thead>
            <tr><th>Item</th><th>Quantity</th><th>Minimum</th><th></th></tr>
        </thead>
        <tbody>
        {% for item in lowStock %}
            <tr>
                <td>{{ item.name }}</td>
                <td>{{ item.quantity }}</td>
                <td>{{ item.minQuantity }}</td>
                <td><a href="{{ path('app_item_stock', {id: item.id}) }}">Stock in</a></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}

{% if is_granted('ROLE_MANAGER') %}
    <a href="{{ path('app_register') }}">Create user</a>
{% endif %}

<a href="{{ path('app_item_index') }}">Items</a>
{% if is_granted('ROLE_MANAGER') %}
    <a href="{{ path('app_supplier_index') }}">Suppliers</a>
{% endif %}

<a href="{{ path('app_transactions') }}">Transaction history</a>

{% endblock %}
